{
  "name": "TOML",
  "scopeName": "source.toml",
  "patterns": [
    { "include": "#comment" },
    { "include": "#table" },
    { "include": "#entry" },
    { "include": "#value" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.toml",
      "match": "#.*$"
    },
    "table": {
      "match": "^\\s*(\\[\\[?)\\s*([^\\]#]*?)\\s*(\\]\\]?)",
      "captures": {
        "1": { "name": "punctuation.definition.table.toml" },
        "2": { "name": "entity.name.section.toml" },
        "3": { "name": "punctuation.definition.table.toml" }
      }
    },
    "entry": {
      "match": "^\\s*((?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'))*)\\s*(=)",
      "captures": {
        "1": { "name": "support.type.property-name.toml" },
        "2": { "name": "keyword.operator.assignment.toml" }
      }
    },
    "value": {
      "patterns": [
        { "include": "#comment" },
        {
          "name": "string.quoted.triple.basic.toml",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [ { "name": "constant.character.escape.toml", "match": "\\\\." } ]
        },
        {
          "name": "string.quoted.triple.literal.toml",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.toml",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [ { "name": "constant.character.escape.toml", "match": "\\\\." } ]
        },
        {
          "name": "string.quoted.single.toml",
          "begin": "'",
          "end": "'|$"
        },
        {
          "name": "constant.other.datetime.toml",
          "match": "\\b\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})?)?"
        },
        {
          "name": "constant.other.time.toml",
          "match": "\\b\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?"
        },
        {
          "name": "constant.language.boolean.toml",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.numeric.toml",
          "match": "(?<![\\w.])[+-]?(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+|(?:inf|nan)\\b|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d[\\d_]*)?)"
        },
        {
          "match": "((?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'))*)\\s*(=)",
          "captures": {
            "1": { "name": "support.type.property-name.toml" },
            "2": { "name": "keyword.operator.assignment.toml" }
          }
        }
      ]
    }
  }
}
