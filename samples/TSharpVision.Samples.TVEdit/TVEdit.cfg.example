# TSharpVision.Samples.TVEdit.cfg.example
#
# Copy this file to TSharpVision.Samples.TVEdit.cfg next to the TVEdit executable.
# Rename it to TSharpVision.Samples.TVEdit.cfg (remove the .example suffix).
# Only the settings you specify are applied; missing settings preserve defaults.
#
# Supported keys:
#   [driver]  name      - Driver to use: sdl | console
#   [graphics]     fontName  - Font family name for the SDL driver

[driver]
name=sdl

[graphics]
fontName=Cascadia Mono

