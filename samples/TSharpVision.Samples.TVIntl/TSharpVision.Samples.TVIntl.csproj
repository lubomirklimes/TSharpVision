<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TSharpVision.Drivers.Console\TSharpVision.Drivers.Console.csproj" />
    <ProjectReference Include="..\..\src\TSharpVision.Drivers.Terminal\TSharpVision.Drivers.Terminal.csproj" />
    <ProjectReference Include="..\..\src\TSharpVision\TSharpVision.csproj" />
    <ProjectReference Include="..\..\tools\TSharpVision.ResourceCompiler\TSharpVision.ResourceCompiler.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\tools\TSharpVision.HelpCompiler\TSharpVision.HelpCompiler.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <IntlResource Include="Resources/app_en.trc" OutputName="app_en.tvr" />
    <IntlResource Include="Resources/app_cs.trc" OutputName="app_cs.tvr" />
    <IntlHelp Include="Help/tvintl_en.txt" OutputName="Help/tvintl_en.hlp" SymbolName="Help/tvintl_en.cs" />
    <IntlHelp Include="Help/tvintl_cs.txt" OutputName="Help/tvintl_cs.hlp" SymbolName="Help/tvintl_cs.cs" />
  </ItemGroup>

  <!--
    No framework translation files are copied: TSharpVision embeds them, the configured
    language is applied by TSharpVisionRuntime.Run, and the Language menu switches through
    TSharpVisionIntl.CreateBuiltInProvider. A tsharpvision_<lang>.tvr placed beside the
    executable would still override single framework strings.
  -->

  <!--
    Ask the tool projects where they put their output instead of assuming
    tools/*/bin/$(Configuration)/$(TargetFramework): that layout changes with an
    artifacts path (UseArtifactsOutput). Global properties (Configuration, ArtifactsPath)
    flow into these calls, matching the ProjectReference builds above.
  -->
  <Target Name="ResolveIntlCompilers" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="..\..\tools\TSharpVision.ResourceCompiler\TSharpVision.ResourceCompiler.csproj"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" PropertyName="ResourceCompilerDll" />
    </MSBuild>
    <MSBuild Projects="..\..\tools\TSharpVision.HelpCompiler\TSharpVision.HelpCompiler.csproj"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" PropertyName="HelpCompilerDll" />
    </MSBuild>
    <Error Condition="!Exists('$(ResourceCompilerDll)')" Text="Resource compiler not built: '$(ResourceCompilerDll)'." />
    <Error Condition="!Exists('$(HelpCompilerDll)')" Text="Help compiler not built: '$(HelpCompilerDll)'." />
  </Target>

  <Target Name="CompileIntlStringResources" BeforeTargets="Build" DependsOnTargets="ResolveIntlCompilers">
    <MakeDir Directories="$(OutDir)" />
    <Exec
      Command="dotnet &quot;$(ResourceCompilerDll)&quot; compile &quot;%(IntlResource.FullPath)&quot; &quot;$(OutDir)%(IntlResource.OutputName)&quot;" />
  </Target>

  <Target Name="CompileIntlHelp" BeforeTargets="Build" DependsOnTargets="ResolveIntlCompilers">
    <MakeDir Directories="$(OutDir)Help" />
    <MakeDir Directories="$(IntermediateOutputPath)Help" />
    <Exec
      Command="dotnet &quot;$(HelpCompilerDll)&quot; --format v2 &quot;%(IntlHelp.FullPath)&quot; &quot;$(OutDir)%(IntlHelp.OutputName)&quot; &quot;$(IntermediateOutputPath)%(IntlHelp.SymbolName)&quot;" />
  </Target>

</Project>
