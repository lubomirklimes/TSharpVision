<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <HelpCompilerDll>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../tools/TSharpVision.HelpCompiler/bin/$(Configuration)/$(TargetFramework)/svhc.dll'))</HelpCompilerDll>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\extensions\TSharpVision.Terminal\TSharpVision.Terminal.csproj" />
    <ProjectReference Include="..\..\src\TSharpVision.Drivers.Console\TSharpVision.Drivers.Console.csproj" />
    <ProjectReference Include="..\..\src\TSharpVision.Drivers.SDL\TSharpVision.Drivers.SDL.csproj" />
    <ProjectReference Include="..\..\src\TSharpVision\TSharpVision.csproj" />
    <ProjectReference Include="..\..\tools\TSharpVision.HelpCompiler\TSharpVision.HelpCompiler.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TSharpVision.Samples.TVTerm.cfg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Help\DEMOHELP.HLP">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <TVTermHelp Include="Assets/Help/tvterm.txt"
                OutputName="Assets/Help/TVTERM.HLP"
                SymbolName="Help/TVTermHelpCtx.cs" />
  </ItemGroup>

  <Target Name="CompileTVTermHelp" BeforeTargets="Build">
    <MakeDir Directories="$(OutDir)Assets/Help" />
    <MakeDir Directories="$(IntermediateOutputPath)Help" />
    <Exec Command="dotnet &quot;$(HelpCompilerDll)&quot; --format v2 &quot;%(TVTermHelp.FullPath)&quot; &quot;$(OutDir)%(TVTermHelp.OutputName)&quot; &quot;$(IntermediateOutputPath)%(TVTermHelp.SymbolName)&quot;" />
  </Target>

</Project>
