<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TSharpVision.Drivers.SDL</PackageId>
    <Description>SDL3 graphical display and input drivers for TSharpVision, including SDL renderer and GPU renderer backends.</Description>
    <PackageTags>tsharpvision;tui;sdl3;graphics;gpu;driver</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- DXC tool — downloaded at restore time for offline HLSL→SPIR-V compilation.
       Not added as a runtime dependency; used only by the CompileHlslShaders target. -->
  <PropertyGroup>
    <_DxcPackageVersion>1.8.2502.7</_DxcPackageVersion>
    <_DxcExe>$(NuGetPackageRoot)microsoft.direct3d.dxc\$(_DxcPackageVersion)\build\native\bin\x64\dxc.exe</_DxcExe>
    <_ShadersDir>$(MSBuildThisFileDirectory)Gpu\Shaders\</_ShadersDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Downloads DXC without adding it as a project/runtime dependency. -->
    <PackageDownload Include="Microsoft.Direct3D.DXC" Version="[$(_DxcPackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TSharpVision\TSharpVision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TSharpVision.Drivers.SDL.Tests" />
    <InternalsVisibleTo Include="TSharpVision.Diagnostics.SdlGlyphs" />
    <!-- Driver-output qualification (TW-4): observes the real translation through internal seams. -->
    <InternalsVisibleTo Include="TSharpWorkbench.Diagnostics.DriverOutput" />
    <!-- Native-pixel qualification (TW-5A): framebuffer / GPU render-target readback seams. -->
    <InternalsVisibleTo Include="TSharpWorkbench.Diagnostics.NativePixels" />
    <!-- Borrowed capture only; Proxy remains the sole driver lifecycle owner. -->
    <InternalsVisibleTo Include="TSharpWorkbench.Proxy" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" />
    <PackageReference Include="SDL3-CS.Linux" />
    <PackageReference Include="SDL3-CS.Linux.Shadercross" />
    <PackageReference Include="SDL3-CS.Linux.TTF" />
    <PackageReference Include="SDL3-CS.MacOS" />
    <PackageReference Include="SDL3-CS.MacOS.Shadercross" />
    <PackageReference Include="SDL3-CS.MacOS.TTF" />
    <PackageReference Include="SDL3-CS.Windows" />
    <PackageReference Include="SDL3-CS.Windows.Shadercross" />
    <PackageReference Include="SDL3-CS.Windows.TTF" />
  </ItemGroup>

  <!-- Pre-compiled SPIR-V blobs embedded into the assembly.
       Generated by the CompileHlslShaders target and committed to the repository.
       On all platforms the runtime loads these bytes and passes them to
       SDL3_shadercross CompileGraphicsShaderFromSPIRV (no DXC needed at runtime). -->
  <ItemGroup>
    <!-- Every committed blob; a shader is named <Name>Vert.spv / <Name>Frag.spv after its HLSL source. -->
    <EmbeddedResource Include="Gpu\Shaders\*.spv" />
  </ItemGroup>

  <!-- ── CompileHlslShaders ──────────────────────────────────────────────────
       Offline HLSL → SPIR-V compilation using DXC.
       Run manually when shader sources change (all Gpu\Shaders\*Vert.hlsl / *Frag.hlsl):
         dotnet msbuild -t:CompileHlslShaders src/TSharpVision.Drivers.SDL/TSharpVision.Drivers.SDL.csproj
       Requires Windows (DXC is a Windows x64 binary from the NuGet package).
       The generated .spv files are committed to the repository so that macOS
       and Linux builds never need DXC at build time or runtime.
       ─────────────────────────────────────────────────────────────────────── -->
  <ItemGroup>
    <_VertexHlsl   Include="$(_ShadersDir)*Vert.hlsl" />
    <_FragmentHlsl Include="$(_ShadersDir)*Frag.hlsl" />
  </ItemGroup>

  <Target Name="CompileHlslShaders"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Inputs="@(_VertexHlsl);@(_FragmentHlsl)"
          Outputs="@(_VertexHlsl->'$(_ShadersDir)%(Filename).spv');@(_FragmentHlsl->'$(_ShadersDir)%(Filename).spv')">

    <Error Condition="!Exists('$(_DxcExe)')"
           Text="DXC not found at '$(_DxcExe)'. Run 'dotnet restore' first to download the Microsoft.Direct3D.DXC package." />

    <Message Text="Compiling HLSL shaders to SPIR-V..." Importance="high" />

    <!-- *Vert.hlsl → vs_6_0, *Frag.hlsl → ps_6_0, entry point main, output beside the source. -->
    <Exec Condition="'%(_VertexHlsl.Identity)' != ''" Command="&quot;$(_DxcExe)&quot; -spirv -T vs_6_0 -E main &quot;%(_VertexHlsl.FullPath)&quot; -Fo &quot;$(_ShadersDir)%(_VertexHlsl.Filename).spv&quot;" />
    <Exec Condition="'%(_FragmentHlsl.Identity)' != ''" Command="&quot;$(_DxcExe)&quot; -spirv -T ps_6_0 -E main &quot;%(_FragmentHlsl.FullPath)&quot; -Fo &quot;$(_ShadersDir)%(_FragmentHlsl.Filename).spv&quot;" />

    <Message Text="SPIR-V output written to Gpu\Shaders\ — commit the .spv files to the repository." Importance="high" />
  </Target>

</Project>
