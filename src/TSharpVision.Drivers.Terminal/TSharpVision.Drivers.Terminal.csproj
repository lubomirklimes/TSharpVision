<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TSharpVision.Drivers.Terminal</PackageId>
    <Description>ANSI/POSIX terminal display and input driver for TSharpVision terminal UI applications.</Description>
    <PackageTags>tsharpvision;tui;terminal;ansi;posix;driver</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TSharpVision\TSharpVision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TSharpVision.Drivers.Terminal.Tests" />
    <!-- Driver-output qualification (TW-4): observes the real translation through internal seams. -->
    <InternalsVisibleTo Include="TSharpWorkbench.Diagnostics.DriverOutput" />
    <!-- Native host rendering (TW-5B): the driver has no Windows TTY attach, so its real VT output is attached to stdout. -->
    <InternalsVisibleTo Include="TSharpWorkbench.Diagnostics.NativeHosts" />
  </ItemGroup>

</Project>
