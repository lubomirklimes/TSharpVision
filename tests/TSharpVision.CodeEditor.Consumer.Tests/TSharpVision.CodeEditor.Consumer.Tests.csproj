<Project Sdk="Microsoft.NET.Sdk">

  <!-- TSharpVision.CodeEditor as an application sees it.

       This project references TSharpVision.CodeEditor and the test framework, and nothing else. The package
       grants it no InternalsVisibleTo, so everything here - a language with its own classifier, a language
       with its own TextMate grammar - is registered through the public API alone. Do not add this assembly
       to the package's InternalsVisibleTo list: the tests would stop proving what they are for. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\extensions\TSharpVision.CodeEditor\TSharpVision.CodeEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A grammar owned by these tests, supplied to the service from this assembly's resources. -->
    <EmbeddedResource Include="Assets\tiny.tmLanguage.json" LogicalName="tiny.tmLanguage.json" />
  </ItemGroup>

</Project>
