<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TSharpVision\TSharpVision.csproj" />
    <ProjectReference Include="..\..\src\TSharpVision.Graphics\TSharpVision.Graphics.csproj" />
    <ProjectReference Include="..\..\extensions\TSharpVision.CodeEditor\TSharpVision.CodeEditor.csproj" />
    <ProjectReference Include="..\..\extensions\TSharpVision.HexView\TSharpVision.HexView.csproj" />
    <ProjectReference Include="..\..\extensions\TSharpVision.TableView\TSharpVision.TableView.csproj" />
    <ProjectReference Include="..\..\extensions\TSharpVision.Terminal\TSharpVision.Terminal.csproj" />
    <ProjectReference Include="..\TSharpVision.TestSupport\TSharpVision.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exercise the sample against NullDriver without referencing executable drivers. -->
    <Compile Include="..\..\samples\TSharpVision.Samples.TVDemo\*.cs"
             Exclude="..\..\samples\TSharpVision.Samples.TVDemo\Program.cs"
             Link="Samples\TVDemo\%(Filename)%(Extension)" />
    <None Include="..\..\samples\TSharpVision.Samples.TVDemo\Help\tvdemo.hlp"
          Link="Help\tvdemo.hlp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- RepositoryLayout (TestSupport) finds the repository from redirected output with this relative path. -->
  <ItemGroup>
    <AssemblyMetadata Include="TSharpVision.RepositoryRootFromOutput"
                      Value="$([MSBuild]::MakeRelative($([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)')), $([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))))" />
  </ItemGroup>

</Project>
